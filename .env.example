# Runtime environment. Never commit real credentials.
BHT_DB_BRANCH=dev
BHT_SESSION_SECRET=replace-with-at-least-32-random-characters

# Neon branches (pooled connections for the web runtime).
DEV_DATABASE_URL=postgresql://user:password@host-dev/database?sslmode=verify-full
DATABASE_URL=postgresql://user:password@host-main/database?sslmode=verify-full

# Optional native Neon Realtime. The app falls back to SSE/polling when absent.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEXT_PUBLIC_NEON_REALTIME_URL=
