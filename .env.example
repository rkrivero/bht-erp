# Neon Postgres Connection Strings (copy to .env and fill with actual values; never commit .env)
# Pooled connection (-pooler) for ERP app / read queries:
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/bht_erp?sslmode=require
# Direct connection (no -pooler) for DDL migrations and bulk ETL loads:
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/bht_erp?sslmode=require

# Branch-specific overrides for dev testing
DEV_DATABASE_URL=postgresql://user:password@ep-dev-pooler.us-east-1.aws.neon.tech/bht_erp?sslmode=require
DEV_DATABASE_URL_UNPOOLED=postgresql://user:password@ep-dev.us-east-1.aws.neon.tech/bht_erp?sslmode=require

NEON_PROJECT_ID=curly-dream-92145694
NEON_ORG_ID=org-young-heart-66934357
NEON_DEFAULT_BRANCH=dev
